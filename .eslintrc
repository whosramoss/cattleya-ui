{
  "root": true,
  "extends": "eslint:recommended",
  "parser": "@typescript-eslint/parser",
  "rules": {
    "comma-dangle": [2, "never"],
    "accessor-pairs": 2,
    "complexity": [2, 6],
    "eqeqeq": 2,
    "guard-for-in": 2,
    "no-alert": 2,
    "no-caller": 2,
    "no-div-regex": 2,
    "no-else-return": 0,
    "no-eq-null": 2,
    "no-eval": 2,
    "no-extend-native": 2,
    "no-extra-bind": 2,
    "no-implied-eval": 2,
    "no-iterator": 2,
    "no-labels": 2,
    "no-lone-blocks": 2,
    "no-loop-func": 2,
    "no-new-func": 2,
    "no-new-wrappers": 2,
    "no-new": 2,
    "no-octal-escape": 2,
    "no-proto": 2,
    "no-return-assign": 2,
    "no-script-url": 2,
    "no-self-compare": 2,
    "no-unused-expressions": [2, { "allowShortCircuit": true }],
    "no-useless-call": 2,
    "no-useless-concat": 2,
    "no-void": 2,
    "radix": 2,
    "wrap-iife": 2,
    "no-label-var": 2,
    "no-undef-init": 2,
    "no-undef": 0,
    "no-unused-vars": 0,
    "block-spacing": 1,
    "brace-style": 1,
    "comma-spacing": [1, { "before": false, "after": true }],
    "comma-style": [1, "last"],
    "eol-last": 2,
    "max-statements": [2, 30],
    "no-mixed-spaces-and-tabs": 0,
    "no-trailing-spaces": 2,
    "object-curly-spacing": [1, "always"],
    "quotes": [2, "single"],
    "semi": [2, "never"],
    "space-before-blocks": 2,
    "no-var": 2,
    "prefer-const": 1,
    "require-yield": 0
  }
}
